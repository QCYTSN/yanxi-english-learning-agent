{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["exam", "target", "base_allocation", "allocation_policy"],
  "properties": {
    "profile_version": {"type": "integer", "minimum": 1},
    "active_learning_track_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "onboarding": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "ready"]},
        "completed_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "exam": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "academic"},
        "test_date": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": true
    },
    "target": {"$ref": "#/$defs/scores"},
    "minimum_required": {"$ref": "#/$defs/scores"},
    "stretch_target": {"$ref": "#/$defs/scores"},
    "current": {
      "type": "object",
      "properties": {
        "listening": {"$ref": "#/$defs/nullableBand"},
        "reading": {"$ref": "#/$defs/nullableBand"},
        "writing": {"$ref": "#/$defs/nullableBand"},
        "speaking": {"$ref": "#/$defs/nullableBand"}
      },
      "additionalProperties": false
    },
    "base_allocation": {"$ref": "#/$defs/allocation"},
    "allocation_policy": {
      "type": "object",
      "required": ["listening_reading_share", "minimum_listening_reading_share", "maximum_listening_reading_share", "maximum_weekly_shift"],
      "properties": {
        "listening_reading_share": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_listening_reading_share": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_listening_reading_share": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_weekly_shift": {"type": "number", "minimum": 0, "maximum": 0.25}
      },
      "additionalProperties": true
    },
    "preferences": {"type": "object"},
    "privacy": {"type": "object"}
  },
  "$defs": {
    "band": {"type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "nullableBand": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "scores": {
      "type": "object",
      "required": ["overall", "listening", "reading", "writing", "speaking"],
      "properties": {
        "overall": {"$ref": "#/$defs/band"},
        "listening": {"$ref": "#/$defs/band"},
        "reading": {"$ref": "#/$defs/band"},
        "writing": {"$ref": "#/$defs/band"},
        "speaking": {"$ref": "#/$defs/band"}
      },
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "required": ["listening", "reading", "writing", "speaking"],
      "properties": {
        "listening": {"type": "number", "minimum": 0, "maximum": 1},
        "reading": {"type": "number", "minimum": 0, "maximum": 1},
        "writing": {"type": "number", "minimum": 0, "maximum": 1},
        "speaking": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
