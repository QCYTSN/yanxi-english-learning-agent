{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "module", "model", "official_score"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "module": {"enum": ["writing", "speaking"]},
    "criterion": {"type": "string"},
    "model": {"type": "string", "minLength": 1},
    "official_score": {"type": "number", "minimum": 0, "maximum": 9},
    "predicted_score": {"type": ["number", "null"], "minimum": 0, "maximum": 9},
    "predicted_low": {"type": ["number", "null"], "minimum": 0, "maximum": 9},
    "predicted_high": {"type": ["number", "null"], "minimum": 0, "maximum": 9},
    "tolerance": {"type": "number", "minimum": 0, "maximum": 2},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
