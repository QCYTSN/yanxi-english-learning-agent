{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "pack_id",
    "module",
    "title",
    "practice_mode",
    "standard_profile",
    "source_type",
    "rights_status",
    "review_status",
    "structure"
  ],
  "properties": {
    "pack_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "module": {"enum": ["listening", "reading", "writing", "speaking"]},
    "title": {"type": "string", "minLength": 1},
    "practice_mode": {"enum": ["full_mock", "section_practice", "question_type_drill", "skill_drill"]},
    "standard_profile": {"const": "ielts-academic"},
    "standard_version": {"type": "string"},
    "source_type": {"enum": ["project_original", "official_external", "licensed_private", "seasonal_reported", "personal", "synthetic"]},
    "authenticity": {"type": ["string", "null"]},
    "rights_status": {"enum": ["redistributable", "external_reference", "local_private"]},
    "review_status": {"enum": ["unreviewed", "in_review", "reviewed", "rejected"]},
    "question_ids": {"type": "array", "items": {"type": "string"}},
    "passage_ids": {"type": "array", "items": {"type": "string"}},
    "media_ids": {"type": "array", "items": {"type": "string"}},
    "structure": {"type": "object"},
    "conformance_status": {"enum": ["verified", "provisional", "skill_only", "rejected"]},
    "conformance_report": {"type": "object"}
  },
  "additionalProperties": true
}
