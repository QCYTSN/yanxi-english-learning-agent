{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "diagnostic_id", "module_status", "evidence_gaps", "recommended_next_steps"],
  "properties": {
    "contract_version": {"const": 1},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "module_status": {
      "type": "object",
      "required": ["listening", "reading", "writing", "speaking"],
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidence"],
        "properties": {
          "status": {"enum": ["complete", "partial", "missing"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommended_next_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
