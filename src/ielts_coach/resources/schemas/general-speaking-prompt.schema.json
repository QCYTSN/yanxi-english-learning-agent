{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "mode",
    "scenario",
    "role",
    "prompt",
    "follow_ups",
    "evaluation_dimensions",
    "limitations"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "practice_prompt",
        "role_play_prompt",
        "evaluation"
      ]
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "follow_ups": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation_dimensions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "observation",
          "suggestion"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}