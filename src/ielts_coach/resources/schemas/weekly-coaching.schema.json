{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "period", "wins", "risks", "next_week_focus", "evidence_limits"],
  "properties": {
    "contract_version": {"const": 1},
    "period": {"type": "string", "minLength": 1},
    "wins": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_week_focus": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "evidence_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
