{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "criterion_score": {
      "type": "object",
      "required": ["criterion"],
      "properties": {
        "criterion": {"enum": ["FC", "LR", "GRA", "PRON"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "score_low": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "score_high": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "confidence": {"enum": ["low", "medium", "high", null]},
        "evidence": {"type": ["array", "string", "null"]},
        "evidence_source": {"enum": ["transcript", "timing", "audio", "voice_model_observation", "mixed", "unspecified", null]}
      },
      "additionalProperties": true
    },
    "rubric": {
      "type": "object",
      "required": ["publisher", "standard", "source_reference"],
      "properties": {
        "publisher": {"const": "IELTS"},
        "standard": {"const": "IELTS Speaking Band Descriptors"},
        "version": {"type": ["string", "null"]},
        "source_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["mode"],
  "properties": {
    "report_version": {"type": "integer", "minimum": 1},
    "session_id": {"type": ["string", "null"]},
    "mode": {"type": "string"},
    "occurred_at": {"type": ["string", "null"]},
    "duration_minutes": {"type": ["number", "null"], "minimum": 0},
    "source": {
      "type": "object",
      "properties": {
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "interaction_mode": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "source_observations": {
      "type": "object",
      "properties": {
        "evidence_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["transcript", "summary", "timing", "audio", "voice_model_observation"]}
        },
        "parts": {"type": "array"},
        "questions": {"type": "array"},
        "transcript": {"type": ["string", "null"]},
        "answer_summary": {"type": ["string", "null"]},
        "fluency_events": {"type": "array"},
        "pronunciation_observations": {"type": "array"}
      },
      "additionalProperties": true
    },
    "source_model_estimate": {
      "type": "object",
      "properties": {
        "model": {"type": ["string", "null"]},
        "estimated_overall": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "criterion_scores": {"type": "array", "items": {"$ref": "#/$defs/criterion_score"}},
        "confidence": {"enum": ["low", "medium", "high", null]}
      },
      "additionalProperties": true
    },
    "local_evaluation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "partial", "completed", "unavailable"]},
        "evaluator_model": {"type": ["string", "null"]},
        "confidence": {"enum": ["low", "medium", "high", null]},
        "estimated_overall": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "criterion_scores": {"type": "array", "items": {"$ref": "#/$defs/criterion_score"}},
        "rubric": {"$ref": "#/$defs/rubric"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "errors": {"type": "array"},
    "feedback": {"type": "object"},
    "document_body": {"type": "string"},

    "estimated_overall": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "parts": {"type": "array"},
    "transcript": {"type": ["string", "null"]},
    "criterion_scores": {"type": "array", "items": {"$ref": "#/$defs/criterion_score"}}
  },
  "additionalProperties": true
}
