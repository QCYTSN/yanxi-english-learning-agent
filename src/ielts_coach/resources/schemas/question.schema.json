{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["question_id", "module", "content", "source_type", "content_hash"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": ["string", "null"]},
    "module": {"enum": ["listening", "reading", "writing", "speaking"]},
    "task": {"type": ["string", "null"]},
    "part": {"type": ["string", "integer", "null"]},
    "question_number": {"type": ["string", "integer", "null"]},
    "question_type": {"type": ["string", "null"]},
    "content": {"type": "string", "minLength": 1},
    "passage_id": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "topic": {"type": ["string", "array"]},
    "source_type": {"enum": ["project_original", "official_external", "licensed_private", "seasonal_reported", "personal", "synthetic"]},
    "authenticity": {"type": ["string", "null"]},
    "review_status": {"type": ["string", "null"]},
    "practice_mode": {"enum": ["full_mock", "section_practice", "question_type_drill", "skill_drill"]},
    "standard_profile": {"type": ["string", "null"]},
    "standard_version": {"type": ["string", "null"]},
    "rights_status": {"enum": ["redistributable", "external_reference", "local_private"]},
    "conformance_status": {"enum": ["verified", "provisional", "skill_only", "rejected"]},
    "conformance_report": {"type": "object"},
    "answer_constraints": {"type": "object"},
    "minimum_words": {"type": ["integer", "null"], "minimum": 1},
    "speaking_set_id": {"type": ["string", "null"]},
    "options": {"type": ["array", "object"]},
    "content_hash": {"type": "string", "minLength": 16}
  },
  "additionalProperties": true
}
