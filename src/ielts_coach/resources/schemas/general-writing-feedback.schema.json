{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "feedback_summary",
    "priority_issues",
    "strengths",
    "revised_example",
    "check_question",
    "limitations"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "feedback_summary": {"type": "string", "minLength": 1},
    "priority_issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["issue", "evidence", "learner_action"],
        "properties": {
          "issue": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "learner_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "revised_example": {"type": "string", "minLength": 1},
    "check_question": {"type": "string", "minLength": 1},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
