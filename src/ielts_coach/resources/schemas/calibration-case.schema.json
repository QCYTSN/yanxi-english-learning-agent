{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "module", "criterion", "official_score", "reference_kind", "source_reference", "input_path", "permissions"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "module": {"enum": ["writing", "speaking"]},
    "task": {"enum": ["task1", "task2", null]},
    "criterion": {"type": "string", "minLength": 1},
    "official_score": {"type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "reference_kind": {"const": "official_scored_sample"},
    "source_reference": {"type": "string", "minLength": 1},
    "input_path": {"type": "string", "minLength": 1},
    "permissions": {
      "type": "object",
      "required": ["user_confirms_legal_use", "redistribution_allowed"],
      "properties": {
        "user_confirms_legal_use": {"const": true},
        "redistribution_allowed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
