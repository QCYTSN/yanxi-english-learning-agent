{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "word",
    "definitions",
    "examples",
    "synonyms",
    "antonyms",
    "forms"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "ipa_uk": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "ipa_us": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "pos": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "definitions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "translation": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 400
          }
        },
        "additionalProperties": false
      }
    },
    "synonyms": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "antonyms": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "forms": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
