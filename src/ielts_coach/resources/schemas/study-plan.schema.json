{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "period", "allocation", "tasks", "evidence_summary"],
  "properties": {
    "contract_version": {"const": 1},
    "period": {"type": "string", "minLength": 1},
    "allocation": {
      "type": "object",
      "required": ["listening", "reading", "writing", "speaking"],
      "properties": {
        "listening": {"type": "number", "minimum": 0, "maximum": 1},
        "reading": {"type": "number", "minimum": 0, "maximum": 1},
        "writing": {"type": "number", "minimum": 0, "maximum": 1},
        "speaking": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module", "title", "minutes", "reason"],
        "properties": {
          "module": {"enum": ["listening", "reading", "writing", "speaking"]},
          "title": {"type": "string", "minLength": 1},
          "minutes": {"type": "integer", "minimum": 5, "maximum": 240},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence_summary": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
