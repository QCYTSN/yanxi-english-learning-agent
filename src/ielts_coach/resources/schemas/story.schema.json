{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["story_id", "title", "events", "usable_topics"],
  "properties": {
    "story_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "people": {"type": "array", "items": {"type": "string"}},
    "places": {"type": "array", "items": {"type": "string"}},
    "events": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "feelings": {"type": "array", "items": {"type": "string"}},
    "lessons": {"type": "array", "items": {"type": "string"}},
    "usable_topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expressions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
