{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["session_id", "module"],
  "properties": {
    "session_id": {"type": "string", "pattern": "^[LRSW]-[0-9]{8}-[0-9]{3}$|^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "module": {"enum": ["listening", "reading", "writing", "speaking"]},
    "track_id": {"const": "ielts-academic"},
    "learning_activity_id": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "question_presented", "learner_working", "awaiting_feedback", "awaiting_revision", "completed", "cancelled"]},
    "revision": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "question_id": {"type": ["string", "null"]},
    "passage_id": {"type": ["string", "null"]},
    "assessment_pack_id": {"type": ["string", "null"]},
    "mode": {"type": ["string", "null"]},
    "practice_mode": {"enum": ["full_mock", "section_practice", "question_type_drill", "skill_drill", null]},
    "conformance_status": {"enum": ["verified", "provisional", "skill_only", "rejected", null]},
    "assessment_contract": {"type": ["object", "null"]},
    "time_limit_minutes": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "started_at": {"type": ["string", "null"]},
    "submitted_at": {"type": ["string", "null"]},
    "answer_revealed_at": {"type": ["string", "null"]},
    "hints_used": {"type": ["integer", "null"], "minimum": 0},
    "task": {"enum": ["task1", "task2", null]},
    "scored_version": {"type": ["string", "null"]},
    "raw_score": {"type": ["number", "null"], "minimum": 0},
    "band": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "estimated_overall": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
    "score_kind": {"enum": ["official_result", "answer_key_estimate", "ai_training_estimate", "partial_profile", "unspecified", null]},
    "score_confidence": {"enum": ["low", "medium", "high", null]},
    "answer_key_source": {"type": ["string", "null"]},
    "band_conversion_source": {"type": ["string", "null"]},
    "score_result": {
      "type": "object",
      "properties": {
        "raw_score": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "band": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "band_range": {"type": ["object", "null"]},
        "score_kind": {"type": "string"},
        "confidence": {"type": "string"},
        "rubric_version": {"type": ["string", "null"]},
        "conversion_source": {"type": ["string", "null"]},
        "evidence_scope": {},
        "evaluator_model": {"type": ["string", "null"]},
        "calibration_status": {"type": "string"},
        "eligible_for_progress": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "rubric": {
      "type": "object",
      "properties": {
        "publisher": {"type": "string"},
        "standard": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "source_reference": {"type": "string"}
      },
      "additionalProperties": true
    },
    "duration_minutes": {"type": ["number", "null"], "minimum": 0},
    "score": {
      "type": "object",
      "properties": {
        "correct": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "content"],
        "properties": {
          "label": {"type": "string"},
          "content": {"type": "string"},
          "word_count": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "criterion_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion"],
        "properties": {
          "criterion": {"type": "string"},
          "version": {"type": "string"},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
          "score_low": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
          "score_high": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
          "confidence": {"enum": ["low", "medium", "high", null]},
          "evidence": {"type": ["array", "string", "null"]},
          "assessment_role": {"enum": ["local_rubric", "source_model", null]},
          "evidence_source": {"enum": ["text", "transcript", "timing", "audio", "voice_model_observation", "mixed", "unspecified", null]}
        },
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_type"],
        "properties": {
          "question_id": {"type": ["string", "null"]},
          "question_number": {"type": ["string", "integer", "null"]},
          "question_type": {"type": "string"},
          "user_answer": {},
          "correct_answer": {},
          "is_correct": {"type": ["boolean", "null"]},
          "duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "evidence_location": {"type": ["string", "null"]},
          "error_tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "errors": {"type": "array"},
    "error_tags": {"type": "array"},
    "speaking_report": {"type": "object"},
    "document_body": {"type": "string"}
  },
  "additionalProperties": true
}
